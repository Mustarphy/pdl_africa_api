# PDL Africa API: environment template.
# Copy to `.env` and fill in real values. Never commit `.env` or any real
# credentials. Production values belong in the server's environment / secret
# manager, not in this file.

APP_NAME="PDL Africa"
# local | testing | staging | production
APP_ENV=local
# Generated per environment with `php artisan key:generate`. Never share or
# reuse keys between environments.
APP_KEY=
# Must be false in staging and production (true exposes stack traces).
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use `warning` or `error` in production.
LOG_LEVEL=debug

# Browser origins allowed to call the API (CORS), comma-separated, exact
# scheme://host[:port] with no trailing slash. Local React (Vite) dev server:
FRONTEND_URLS=http://localhost:5173

# Hosts (host[:port], no scheme) whose requests use Sanctum cookie sessions
# (admin area and customer accounts). Must match the frontend origin(s) above. The frontend
# and API must share a parent domain in production (e.g. pdlafrica.com and
# api.pdlafrica.com) with SESSION_DOMAIN=.pdlafrica.com.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Disk for catalog images (`public` locally; e.g. `s3` in production with
# the matching AWS_* settings and a public/CDN URL). See README.
CATALOG_IMAGE_DISK=public

# MySQL / MariaDB. Use a dedicated least-privilege user, never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdl_africa
DB_USERNAME=pdl_africa
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true wherever the API is served over HTTPS (staging/production).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Customer account emails (verification, password reset, security notices)
# are sent synchronously; no queue worker is needed. `log` writes them to
# storage/logs instead of sending (local development). For real delivery use
# `smtp` with a transactional provider and a verified sender domain; the
# credentials belong in the server's secret store, never in this file.
# To catch emails locally with MailHog (inbox at http://localhost:8025):
#   docker run -d --name pdl-mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog:v1.0.1
# then set MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payments (Paystack) ---------------------------------------------------
# Secret key: server only (never in a VITE_* variable). Use sk_test_... keys
# locally and in staging; sk_live_... only in production. The same key signs
# webhooks (x-paystack-signature).
PAYSTACK_SECRET_KEY=
# Public key (not used by the API today; kept with the secret for reference).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
# Must match the catalogue currency (config/catalog.php); no conversion.
PAYSTACK_CURRENCY=NGN

# --- Delivery fees -----------------------------------------------------------
# Per zone: a fee in whole naira (charged online), `collect` (the customer
# pays the rider/courier on delivery; nothing is charged online for it), or
# blank (zone switched off: no online checkout there). See config/shipping.php.
SHIPPING_FEE_LAGOS=
SHIPPING_ESTIMATE_LAGOS=
SHIPPING_FEE_NIGERIA=
SHIPPING_ESTIMATE_NIGERIA=
SHIPPING_FEE_INTERNATIONAL=
SHIPPING_ESTIMATE_INTERNATIONAL=

# Storefront origin used for links in account emails (no trailing slash).
# Defaults to the first FRONTEND_URLS entry.
FRONTEND_URL=http://localhost:5173
# Lifetime of email verification / email-change links, in minutes.
ACCOUNT_LINK_EXPIRE_MINUTES=60
